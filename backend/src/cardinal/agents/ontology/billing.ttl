    card:priority card:Structural .
bill:f_cycle_ending_balance card:directlyDependsOn bill:f_fees .
bill:dep_ceb_credits a card:Dependency ;
    card:source bill:f_credits ; card:target bill:f_cycle_ending_balance ;
    card:lag 0 ;
    card:mechanism card:Formula ;
    card:priority card:Structural .
bill:f_cycle_ending_balance card:directlyDependsOn bill:f_credits .
bill:dep_ceb_int a card:Dependency ;
    card:source bill:f_interest_charged ; card:target bill:f_cycle_ending_balance ;
    card:lag 0 ;
    card:mechanism card:Formula ;
    card:priority card:Structural ;
    card:why "Charged interest is added into the ending balance." .
bill:f_cycle_ending_balance card:directlyDependsOn bill:f_interest_charged .
bill:dep_adb_cash a card:Dependency ;
    card:source bill:f_cash_advance ; card:target bill:f_average_daily_balance ;
    card:lag 0 ;
    card:mechanism card:Formula ;
    card:priority card:Structural .
bill:f_average_daily_balance card:directlyDependsOn bill:f_cash_advance .
bill:dep_min_fees a card:Dependency ;
    card:source bill:f_fees ; card:target bill:f_minimum_payment_due ;
    card:lag 0 ;
    card:mechanism card:Formula ;
    card:priority card:Structural .
bill:f_minimum_payment_due card:directlyDependsOn bill:f_fees .
bill:dep_min_int a card:Dependency ;
    card:source bill:f_interest_charged ; card:target bill:f_minimum_payment_due ;
    card:lag 0 ;
