    card:priority card:Structural .
bill:f_minimum_payment_due card:directlyDependsOn bill:f_interest_charged .

# ---- Invariants ----
bill:inv_grace_no_interest a card:Invariant ;
    skos:prefLabel "Grace implies no interest"@en ;
    card:expr "f_grace_eligible implies f_interest_charged == 0" ;
    card:severity "hard" ;
    card:appliesToGrain bill:AccountCycle ;
    card:priority card:Regulatory ;
    dct:source "Reg Z 1026.54"@en .
bill:inv_balance_recurrence a card:Invariant ;
    skos:prefLabel "Balance recurrence"@en ;
    card:expr "abs(f_cycle_ending_balance - (f_beginning_balance + f_purchases + f_cash_advance + f_fees + f_interest_charged - f_payments - f_credits)) < 0.01" ;
    card:severity "hard" ;
    card:appliesToGrain bill:AccountCycle ;
    card:priority card:Structural .
bill:inv_interest_nonneg a card:Invariant ;
    skos:prefLabel "Interest not negative"@en ;
    card:expr "f_interest_charged >= 0" ;
    card:severity "hard" ;
    card:appliesToGrain bill:AccountCycle ;
    card:priority card:Structural .
bill:inv_min_nonneg a card:Invariant ;
    skos:prefLabel "Minimum payment not negative"@en ;
    card:expr "f_minimum_payment_due >= 0" ;
    card:severity "hard" ;
    card:appliesToGrain bill:AccountCycle ;
    card:priority card:Structural .
bill:inv_min_le_statement a card:Invariant ;
    skos:prefLabel "Minimum payment capped at statement balance"@en ;
    card:expr "f_minimum_payment_due <= f_statement_balance" ;
    card:severity "hard" ;
    card:appliesToGrain bill:AccountCycle ;
    card:priority card:Regulatory ;
    dct:source "Reg Z (min payment cannot exceed amount owed)"@en .

# ---- Obligations ----
bill:ob_grace a card:RegulatoryObligation ;
    skos:prefLabel "Grace period handling"@en ;
    card:triggeredByField bill:f_revolving_balance ;
    card:requiresField bill:f_paid_in_full_last_cycle , bill:f_grace_eligible , bill:f_interest_charged ;
    card:requiresInvariant bill:inv_grace_no_interest ;
    card:priority card:Regulatory ;
    dct:source "Reg Z 1026.7(b), 1026.54"@en ;
    card:ask "Since accounts can revolve, we must model the grace period. Add paid-in-full tracking, grace eligibility, and gated interest?" ;
    card:why "If accounts can revolve, grace-period math is required by law. Getting it wrong misstates interest." .
bill:ob_balance_recurrence a card:Obligation ;
    skos:prefLabel "Balance must reconcile"@en ;
    card:triggeredByField bill:f_cycle_ending_balance ;
    card:requiresInvariant bill:inv_balance_recurrence ;
    card:priority card:Structural ;
    card:why "Once there is an ending balance, it must equal last balance plus flows. The accounting identity." .
